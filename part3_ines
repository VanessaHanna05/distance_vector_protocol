#ifndef IFF_LOOPBACK
//Linux use 0x8 for IFF_LOOPBACK
#define IFF_LOOPBACK 0x0008
#endif

#define HELLO_INTERVAL 5
#define TIMEOUT 10
#define PORT 5555
#define BUF_SIZE 1024

//From part 2 
extern void set_my_ip(const char *ip); 
extern char* getDistanceVector(void); //This gives "<myIP>:DV:(dest,cost):..."
extern void processDistanceVector(char *msg); //To parse & update DT (calls dvUpdate internally)
extern void dvSent(void); //To clear “changed” flag
